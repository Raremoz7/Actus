# Vars EXPO_PUBLIC_* sao embutidas no bundle do app (publicas).
# NUNCA colocar segredos de servidor aqui.

# URL base da API Actus (sem /api, sem /v1). Ex: https://api.actus.fit ou http://192.168.0.10:3000 em dev
EXPO_PUBLIC_API_BASE_URL=

# DSN do Sentry (observabilidade). Vazio = Sentry desligado.
EXPO_PUBLIC_SENTRY_DSN=
