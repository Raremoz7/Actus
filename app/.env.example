# Vars EXPO_PUBLIC_* sao embutidas no bundle do app (publicas).
# NUNCA colocar segredos de servidor aqui.

# URL base da API Actus (sem /api, sem /v1). Ex: https://api.actus.fit ou http://192.168.0.10:3000 em dev
EXPO_PUBLIC_API_BASE_URL=

# [DEV] So no navegador (Expo web): backend sem CORS bloqueia chamada direta. Aponte para o
# proxy CORS local (npm run cors-proxy). Vazio = web usa a URL acima. Nativo ignora.
EXPO_PUBLIC_API_BASE_URL_WEB=

# DSN do Sentry (observabilidade). Vazio = Sentry desligado.
EXPO_PUBLIC_SENTRY_DSN=

# [DEV] Bypass de auth: '1' liga sessao falsa e libera todas as telas sem login/backend.
# Default 0 (desligado). NUNCA usar '1' em producao.
EXPO_PUBLIC_DEV_BYPASS_AUTH=0
# Em qual area cair no boot com o bypass: aluno | personal | nutricionista
EXPO_PUBLIC_DEV_TIPO=aluno
