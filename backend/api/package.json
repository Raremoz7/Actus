{
  "name": "actus-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --import tsx --watch src/index.ts",
    "dev:dist": "npm run build && node --watch --env-file=.env.local dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env.local dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "openapi-types": "^12.1.3",
    "pg": "^8.16.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.2.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "pg-mem": "^3.0.5",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
